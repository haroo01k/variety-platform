# 이 파일을 복사해 .env.local로 만들고 실제 값을 채우세요.
#   cp .env.example .env.local
# .env.local은 .gitignore에 포함되어 있어 커밋되지 않습니다.
# 자세한 발급 방법은 supabase/README.md를 참고하세요.

# Supabase 프로젝트 URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon(public) key (Project Settings → API → anon public)
# ⚠️ service_role 키는 절대 여기에 넣지 마세요.
VITE_SUPABASE_ANON_KEY=
